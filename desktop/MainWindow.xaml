<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voicemeeter Reconnect" Width="1080" Height="760" MinWidth="940" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#F4F6FA" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#202C42">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#E9EDF6"/><Setter Property="Foreground" Value="#344563"/>
      <Setter Property="Padding" Value="18,10"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#ABB9D0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,4"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="NavPlate" Padding="18,14" CornerRadius="9" Background="Transparent"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavPlate" Property="Background" Value="#2B3D60"/><Setter Property="Foreground" Value="White"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavPlate" Property="Background" Value="#223554"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#F7F9FC"/><Setter Property="Foreground" Value="#202C42"/><Setter Property="BorderBrush" Value="#DCE3EF"/>
      <Setter Property="Padding" Value="12,9"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="InputPlate" CornerRadius="7" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputPlate" Property="BorderBrush" Value="#5879E6"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <DockPanel LastChildFill="True">
          <Border x:Name="Switch" DockPanel.Dock="Right" Width="40" Height="23" Margin="20,0,0,0" CornerRadius="12" Background="#CCD4E2">
            <Ellipse x:Name="Knob" Width="17" Height="17" Fill="White" HorizontalAlignment="Left" Margin="3"/>
          </Border><ContentPresenter VerticalAlignment="Center"/>
        </DockPanel>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="#5275DE"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="23"/><Setter Property="BorderBrush" Value="#E6EBF3"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#748199"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="FontWeight" Value="Medium"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="198"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#17263F" Grid.Column="0">
      <Grid Margin="18,30,18,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="10,0,0,30">
          <Border Width="40" Height="40" Background="#5C7DE9" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,15">
            <TextBlock Text="∿" Foreground="White" FontFamily="Segoe UI" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/>
          </Border>
          <TextBlock Text="Reconnect" FontFamily="Segoe UI" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="VOICEMEETER 助手" Foreground="#8496B5" FontSize="10" Margin="0,7,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <RadioButton Name="NavOverview" GroupName="Nav" IsChecked="True" Style="{StaticResource Nav}"><TextBlock Text="◉    运行概览"/></RadioButton>
          <RadioButton Name="NavSettings" GroupName="Nav" Style="{StaticResource Nav}"><TextBlock Text="⚙    运行设置"/></RadioButton>
          <RadioButton Name="NavLogs" GroupName="Nav" Style="{StaticResource Nav}"><TextBlock Text="≡    事件记录"/></RadioButton>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="10,0,0,0"><TextBlock Text="轻量运行 · 自动恢复" Foreground="#A3B2C9" FontSize="11"/><TextBlock Text="原生桌面版  2.0" Foreground="#657C9D" FontSize="10" Margin="0,7,0,0"/><Button Name="ExitButton" Content="退出程序" Background="#223554" Foreground="#ADBBD0" Margin="0,18,10,0" FontSize="11" Padding="12,8" HorizontalAlignment="Left"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,29,32,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,24">
        <StackPanel><TextBlock Name="PageTitle" Text="运行概览" FontSize="25" FontWeight="SemiBold"/><TextBlock Name="PageSubtitle" Text="设备自由连接，音频自动归位。" Foreground="#7B879C" Margin="0,7,0,0"/></StackPanel>
        <Button Name="HideButton" Content="收起到托盘" HorizontalAlignment="Right" VerticalAlignment="Center" Background="White"/>
      </Grid>
      <Grid Grid.Row="1">
        <Grid Name="OverviewPage">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Background="#EAF0FF" BorderBrush="#DAE4FC" Margin="0,0,0,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,18,0"><TextBlock Name="StateText" Text="监控已暂停" FontSize="20" FontWeight="SemiBold" Foreground="#2C4B93"/><TextBlock Name="StateDetail" Text="开始监控后自动识别当前硬件输出" Foreground="#637AA5" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
              <Button Name="ToggleMonitor" Grid.Column="1" Content="开始监控" Background="#5275DE" Foreground="White" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="监控输出" Style="{StaticResource Label}"/><TextBlock Name="OutputCount" Text="—" FontSize="27" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="本次重启" Style="{StaticResource Label}"/><TextBlock Name="RestartCount" Text="0" FontSize="27" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="上次提交重启" Style="{StaticResource Label}"/><TextBlock Name="LastRestart" Text="尚未触发" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
          </UniformGrid>
          <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,13"><TextBlock Text="当前硬件输出" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="自动跟随绑定" Foreground="#8793A7" HorizontalAlignment="Right"/></DockPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid><TextBlock Name="EmptyOutputs" Text="暂无设备状态，开始监控后自动显示。" Foreground="#8793A7" Margin="0,22,0,0"/>
                  <ItemsControl Name="OutputsList"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="#F7F9FC" CornerRadius="8" Padding="12,13" Margin="0,0,0,8">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Bus}" FontSize="16" FontWeight="SemiBold" Foreground="#5873BA" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Device}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Device}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding Color}" VerticalAlignment="Center" FontWeight="Medium"/>
                      </Grid>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </Grid>
              </ScrollViewer>
              <TextBlock Grid.Row="2" Text="设备关机时保持等待，仅在确认重连并稳定后恢复。" Foreground="#8B96AA" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </Grid>
          </Border>
        </Grid>
        <Grid Name="SettingsPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
              <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
                <TextBlock Text="连接与恢复" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,19"/>
                <UniformGrid Columns="2">
                  <StackPanel Margin="0,0,16,16"><TextBlock Text="检测间隔（秒）" Style="{StaticResource FieldLabel}"/><TextBox Name="PollInput" AutomationProperties.Name="检测间隔"/><TextBlock Text="0.5～60，默认 2" Foreground="#8B96AA" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                  <StackPanel Margin="0,0,0,16"><TextBlock Text="重连稳定等待（秒）" Style="{StaticResource FieldLabel}"/><TextBox Name="SettleInput" AutomationProperties.Name="重连稳定等待"/><TextBlock Text="在线持续稳定后再重启，默认 7" Foreground="#8B96AA" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                  <StackPanel Margin="0,0,16,16"><TextBlock Text="重启冷却（秒）" Style="{StaticResource FieldLabel}"/><TextBox Name="CooldownInput" AutomationProperties.Name="重启冷却"/><TextBlock Text="所有输出共用的最短重启间隔" Foreground="#8B96AA" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                  <StackPanel Margin="0,0,0,16"><TextBlock Text="失败重试间隔（秒）" Style="{StaticResource FieldLabel}"/><TextBox Name="RetryInput" AutomationProperties.Name="失败重试间隔"/><TextBlock Text="也用于等待 Voicemeeter 启动" Foreground="#8B96AA" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                </UniformGrid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="失败重试上限（次）" FontWeight="Medium"/><TextBlock Text="0 为不重试，首次尝试不计入；最多 5 次。" Foreground="#8B96AA" FontSize="11" Margin="0,5,0,0"/></StackPanel><TextBox Name="MaxRetriesInput" AutomationProperties.Name="失败重试上限" Grid.Column="1"/>
                </Grid>
                <Border Background="#F1F5FD" CornerRadius="7" Padding="12" Margin="0,16,0,0"><TextBlock Text="仅在重启命令失败时重试。命令提交成功后停止重试；在线状态不代表实际出声。设备再次离线或绑定改变会取消等待。" TextWrapping="Wrap" Foreground="#6E7F9F" FontSize="11"/></Border>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
                <TextBlock Text="启动与后台" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,17"/>
                <CheckBox Name="AutoStartCheck" Content="登录 Windows 后自动启动" Margin="0,0,0,19"/>
                <CheckBox Name="StartMonitorCheck" Content="程序启动后自动开始监控"/>
                <TextBlock Text="开机启动时安静进入托盘；关闭窗口继续后台运行。" Foreground="#8B96AA" FontSize="11" Margin="0,16,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Voicemeeter 接口" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="通常自动查找官方安装目录。自定义安装可手动选择 DLL。" Foreground="#8B96AA" FontSize="11" Margin="0,0,0,10"/>
                <DockPanel><Button Name="BrowseDll" Content="选择…" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Name="DllInput" AutomationProperties.Name="官方 DLL 路径" ToolTip="留空自动查找官方安装目录"/></DockPanel>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="1" Margin="0,16,0,0"><TextBlock Name="SettingsMessage" Text="保存后立即生效，无需重启程序。" Foreground="#8090AA" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,150,0"/><Button Name="SaveSettings" Content="保存并应用" Background="#5275DE" Foreground="White" HorizontalAlignment="Right"/></Grid>
        </Grid>
        <Grid Name="LogsPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,17"><Button Name="OpenLogFolder" Content="打开日志文件夹" DockPanel.Dock="Right"/><TextBlock Text="仅记录状态变化与恢复事件，自动限制文件大小。" Foreground="#7B879C" VerticalAlignment="Center"/></DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="17"><TextBox Name="LogText" IsReadOnly="True" Background="White" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/></Border>
        </Grid>
      </Grid>
      <DockPanel Grid.Row="2" Margin="0,17,0,0"><TextBlock Text="自动监控全部硬件输出 · 保留现有音频路由" Foreground="#8B96AA" FontSize="10"/><TextBlock Name="FooterStatus" Text="后台就绪" Foreground="#8B96AA" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
    </Grid>
  </Grid>
</Window>
